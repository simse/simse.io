---
import "../app.css";

interface Props {
	title: string;
}

const { title } = Astro.props;

const createTitle = (title: string) => {
	if (title.includes("—")) return title;

	return title ? title : "Simon Sorensen—Software Engineer in London";
};
---

<html lang="en" class="scrollbar-thumb-black scrollbar-track-black/30">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{createTitle(title)}</title>
      <link rel="canonical" href="https://simse.io" />
    <style is:inline>
      @font-face {
        font-family: 'Chicago';
        src: url('/fonts/Chicago.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
          font-family: 'ArialPixel';
          src: url('/fonts/Arial.woff2') format('woff2');
          font-weight: 400;
          font-display: swap;
      }
      @font-face {
          font-family: 'Homebrew';
          src: url('/fonts/Homebrew.woff2') format('woff2');
          font-weight: 400;
          font-display: swap;
      }
      @font-face {
          font-family: 'Adams';
          src: url('/fonts/Adams.woff2') format('woff2');
          font-weight: 400;
          font-display: swap;
      }

    </style>
      <script>
          import posthog from 'posthog-js'
          import { POSTHOG_API_KEY, POSTHOG_HOST } from 'astro:env/client';

          posthog.init(POSTHOG_API_KEY, {
              api_host: POSTHOG_HOST,
              defaults: '2025-05-24',
              capture_heatmaps: false,
              capture_exceptions: true,
              capture_performance: true,
              capture_pageview: true,
              cookieless_mode: 'always',
              disable_surveys: true,
              disable_session_recording: true,
              loaded: (posthogInstance) => {
                  window.posthog = posthogInstance
              },
          })
      </script>
  </head>
  <body class="bg-[#FAF2E8] antialiased">
    <slot />
  </body>
</html>

{
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "simse-io-v2",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "23c71c93e44a4b5a98296b7db80ee085",
    },
  ],
  "images": {
    "binding": "IMAGES",
    "remote": true,
  },
  "observability": {
    "enabled": true,
  },
}

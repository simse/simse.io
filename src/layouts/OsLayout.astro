---
import "../styles/os.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en" class="scrollbar-thumb-black scrollbar-track-black/30">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href="https://simse.io/os" />
    <style is:inline>
      @font-face {
        font-family: 'Chicago';
        src: url('/fonts/Chicago.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'ArialPixel';
        src: url('/fonts/Arial.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'Homebrew';
        src: url('/fonts/Homebrew.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'Adams';
        src: url('/fonts/Adams.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
    </style>
  </head>
  <body class="bg-[#FAF2E8] font-os-sans antialiased">
    <slot />
  </body>
</html>

---
import { getEntry, render } from 'astro:content';
import BaseLayout from "../layouts/BaseLayout.astro";
import HomepageGrid from "../components/HomepageGrid.astro";
import { Navigation } from "../components/Navigation";

const { thing: thingSlug } = Astro.params;

if (!thingSlug) {
	return Astro.rewrite('/404');
}

const thing = await getEntry('things', thingSlug);

if (!thing) {
	return Astro.rewrite('/404');
}

const { Content } = await render(thing);
---
<BaseLayout>
	<Navigation client:load transition:persist="site-nav" />
	
	<HomepageGrid />
	
	<div class="top-0 left-0 w-full h-full fixed z-50 flex justify-center overflow-y-scroll overscroll-contain py-12">
		<a
			href="/"
			data-close-modal
			transition:name="modal-overlay"
			class="bg-black/70 top-0 left-0 w-full h-full fixed z-40 hover:cursor-default"
		></a>

		<div
			transition:name="modal-box"
			class="bg-white w-fit h-fit min-w-3xl min-h-128 my-auto rounded-lg z-50 overflow-clip"
		>
			<header class="bg-zinc-200 w-full h-48">
				image would potentially go here
			</header>
			
			<main class="p-8">
				<Content />
			</main>
		</div>
	</div>
</BaseLayout>

<style is:global>
	html {
		overflow: hidden;
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const close = document.querySelector('[data-close-modal]');
		if (!close) return;
		close.addEventListener('click', (event) => {
			const ref = document.referrer;
			const cameFromSameOrigin = ref && new URL(ref).origin === location.origin;
			if (cameFromSameOrigin && history.length > 1) {
				event.preventDefault();
				history.back();
			}
		});
	});
</script>